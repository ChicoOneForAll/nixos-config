// Misc global settings.
// Hotkey overlay: disable the "Important Hotkeys" pop-up at startup.
hotkey-overlay {
    skip-at-startup
}

// Ask clients to omit their client-side decorations if possible.
// Restart apps for this to take effect.
prefer-no-csd

// Where screenshots are saved (strftime-formatted).
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Animation settings. Uncomment "off" to turn off all animations.
animations {
    // off
    // slowdown 3.0
}

// Allows notification actions and window activation from Noctalia.
debug {
    honor-xdg-activation-with-invalid-serial
}
